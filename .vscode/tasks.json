{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "group": "build",
      "isBackground": true,
      "label": "npm: watch",
      "problemMatcher": {
        "base": "$eslint-stylish",
        "background": {
          "beginsPattern": {
            "regexp": "^esbuild:started$"
          },
          "endsPattern": {
            "regexp": "^esbuild:watching$"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "build",
      "group": "build",
      "label": "npm: build"
    },
    {
      "type": "npm",
      "script": "pretest:e2e",
      "group": "build",
      "label": "npm: pretest:e2e"
    }
  ]
}
